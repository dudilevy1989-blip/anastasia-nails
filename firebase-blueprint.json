{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A booked nail salon appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string", "maxLength": 100 },
        "clientPhone": { "type": "string", "maxLength": 30 },
        "serviceId": { "type": "string", "maxLength": 50 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 10 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "pending", "cancelled", "completed", "no-show", "no_show"] },
        "notes": { "type": "string", "maxLength": 500 },
        "reminderSent": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["clientName", "clientPhone", "serviceName", "date", "startTime", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "A nail salon customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "totalVisits": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastVisit": { "type": "string" },
        "nextAppointment": { "type": "string" },
        "avatarColor": { "type": "string" }
      },
      "required": ["fullName", "phone"]
    },
    "Service": {
      "title": "Service",
      "description": "A salon service offered to clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "durationMinutes": { "type": "number" },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 300 },
        "colorTag": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "durationMinutes", "price"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Business settings and working hours",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "instagram": { "type": "string", "maxLength": 100 },
        "slotInterval": { "type": "number" },
        "autoConfirm": { "type": "boolean" }
      },
      "required": ["businessName"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of appointments scheduled in the salon"
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of salon customers"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Catalog of services and treatments offered"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Salon configuration, working hours and preferences"
    }
  }
}
